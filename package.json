{
  "name": "@accodev/hairline",
  "version": "1.1.1",
  "description": "A status line for Claude Code and Pi.",
  "license": "MIT",
  "type": "module",
  "repository": "github:accodev/hairline",
  "keywords": ["pi-package"],
  "files": ["pi/index.ts", "pi/line.ts", "pi/anim.ts"],
  "pi": {
    "extensions": ["./pi/index.ts"]
  },
  "scripts": {
    "typecheck:pi": "tsc -p pi",
    "test:pi": "node --experimental-strip-types --no-warnings --test pi/tests.ts",
    "e2e:claude": "node --experimental-strip-types --no-warnings tests/e2e/claude.spec.ts",
    "e2e:pi": "node --experimental-strip-types --no-warnings tests/e2e/pi.spec.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@types/node": "^26.6.6",
    "@xterm/headless": "6.0.0",
    "fast-check": "4.11.0",
    "typescript": "7.0.2"
  }
}
